{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spool",
  "version": "0.1.1",
  "identifier": "dev.spool.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spool",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}
